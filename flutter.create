import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Profile Card',
      theme: ThemeData(
        useMaterial3: true,
        fontFamily: 'Arial',
        colorScheme: ColorScheme.fromSeed(
          seedColor: const Color(0xFF6D1F2B),
        ),
      ),
      home: const ProfilePage(),
    );
  }
}

class ProfilePage extends StatelessWidget {
  const ProfilePage({super.key});

  // Warna utama
  static const Color burgundy = Color(0xFF6D1F2B);
  static const Color darkBurgundy = Color(0xFF4A111B);
  static const Color gold = Color(0xFFC9A45C);
  static const Color softBackground = Color(0xFFF7F5F4);

  @override
  Widget build(BuildContext context) {
    // MediaQuery digunakan untuk menentukan ukuran layar.
    final double screenWidth = MediaQuery.of(context).size.width;

    // Jika layar lebih dari 600px, gunakan layout horizontal.
    final bool isWideScreen = screenWidth > 600;

    return Scaffold(
      backgroundColor: softBackground,
      body: SafeArea(
        child: Center(
          child: SingleChildScrollView(
            padding: const EdgeInsets.all(24),
            child: Container(
              constraints: const BoxConstraints(
                maxWidth: 950,
              ),
              decoration: BoxDecoration(
                color: Colors.white,
                borderRadius: BorderRadius.circular(28),
                boxShadow: [
                  BoxShadow(
                    color: Colors.black.withOpacity(0.08),
                    blurRadius: 30,
                    offset: const Offset(0, 15),
                  ),
                ],
              ),
              clipBehavior: Clip.antiAlias,
              child: Column(
                children: [
                  // ==============================
                  // HEADER
                  // ==============================
                  Container(
                    width: double.infinity,
                    padding: const EdgeInsets.fromLTRB(
                      28,
                      26,
                      28,
                      34,
                    ),
                    decoration: const BoxDecoration(
                      gradient: LinearGradient(
                        colors: [
                          darkBurgundy,
                          burgundy,
                        ],
                        begin: Alignment.topLeft,
                        end: Alignment.bottomRight,
                      ),
                    ),
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Row(
                          mainAxisAlignment:
                              MainAxisAlignment.spaceBetween,
                          children: [
                            const Text(
                              'PROFILE',
                              style: TextStyle(
                                color: Colors.white,
                                fontSize: 13,
                                fontWeight: FontWeight.w700,
                                letterSpacing: 3,
                              ),
                            ),

                            Container(
                              padding: const EdgeInsets.symmetric(
                                horizontal: 12,
                                vertical: 6,
                              ),
                              decoration: BoxDecoration(
                                border: Border.all(
                                  color: gold.withOpacity(0.7),
                                ),
                                borderRadius:
                                    BorderRadius.circular(20),
                              ),
                              child: const Text(
                                'PERSONAL',
                                style: TextStyle(
                                  color: gold,
                                  fontSize: 10,
                                  fontWeight: FontWeight.bold,
                                  letterSpacing: 1.5,
                                ),
                              ),
                            ),
                          ],
                        ),

                        const SizedBox(height: 22),

                        const Text(
                          'Get to know me',
                          style: TextStyle(
                            color: Colors.white,
                            fontSize: 28,
                            fontWeight: FontWeight.w700,
                          ),
                        ),

                        const SizedBox(height: 6),

                        Text(
                          'A simple introduction and professional profile.',
                          style: TextStyle(
                            color: Colors.white.withOpacity(0.72),
                            fontSize: 14,
                          ),
                        ),
                      ],
                    ),
                  ),

                  // ==============================
                  // PROFILE CONTENT
                  // ==============================
                  Padding(
                    padding: const EdgeInsets.all(28),
                    child: Column(
                      children: [
                        // Responsive:
                        // > 600px = Row
                        // <= 600px = Column
                        isWideScreen
                            ? Row(
                                crossAxisAlignment:
                                    CrossAxisAlignment.start,
                                children: [
                                  _buildProfilePhoto(),
                                  const SizedBox(width: 30),
                                  Expanded(
                                    child: _buildProfileInfo(),
                                  ),
                                ],
                              )
                            : Column(
                                children: [
                                  _buildProfilePhoto(),
                                  const SizedBox(height: 24),
                                  _buildProfileInfo(),
                                ],
                              ),

                        const SizedBox(height: 28),

                        // Garis pemisah
                        Container(
                          height: 1,
                          color: const Color(0xFFEAE4E2),
                        ),

                        const SizedBox(height: 24),

                        // ==============================
                        // CONTACT
                        // ==============================
                        _buildContactSection(),

                        const SizedBox(height: 28),

                        // ==============================
                        // SKILLS
                        // ==============================
                        _buildSkillsSection(),
                      ],
                    ),
                  ),
                ],
              ),
            ),
          ),
        ),
      ),
    );
  }

  // =========================================================
  // FOTO PROFIL
  // Stack + Positioned digunakan untuk badge Available.
  // =========================================================
  Widget _buildProfilePhoto() {
    return Stack(
      clipBehavior: Clip.none,
      alignment: Alignment.center,
      children: [
        Container(
          padding: const EdgeInsets.all(5),
          decoration: BoxDecoration(
            shape: BoxShape.circle,
            border: Border.all(
              color: gold,
              width: 2,
            ),
          ),
          child: const CircleAvatar(
            radius: 82,
            backgroundColor: Color(0xFFE8D9D6),
            backgroundImage: NetworkImage(
              'https://images.unsplash.com/photo-1494790108377-be9c29b29330'
              '?auto=format&fit=crop&w=500&q=80',
            ),
          ),
        ),

        // Badge menggunakan Positioned
        Positioned(
          bottom: -4,
          right: 5,
          child: Container(
            padding: const EdgeInsets.symmetric(
              horizontal: 12,
              vertical: 7,
            ),
            decoration: BoxDecoration(
              color: Colors.white,
              borderRadius: BorderRadius.circular(20),
              border: Border.all(
                color: const Color(0xFFE8E1DF),
              ),
              boxShadow: [
                BoxShadow(
                  color: Colors.black.withOpacity(0.12),
                  blurRadius: 10,
                  offset: const Offset(0, 4),
                ),
              ],
            ),
            child: Row(
              mainAxisSize: MainAxisSize.min,
              children: [
                Container(
                  width: 8,
                  height: 8,
                  decoration: const BoxDecoration(
                    color: Color(0xFF3A9D5D),
                    shape: BoxShape.circle,
                  ),
                ),
                const SizedBox(width: 6),
                const Text(
                  'Available',
                  style: TextStyle(
                    color: darkBurgundy,
                    fontSize: 11,
                    fontWeight: FontWeight.w700,
                  ),
                ),
              ],
            ),
          ),
        ),
      ],
    );
  }

  // =========================================================
  // INFORMASI PROFIL
  // =========================================================
  Widget _buildProfileInfo() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        const Text(
          'Yazkaa Zahaa',
          style: TextStyle(
            color: darkBurgundy,
            fontSize: 30,
            fontWeight: FontWeight.w800,
            letterSpacing: -0.5,
          ),
        ),

        const SizedBox(height: 7),

        Row(
          children: [
            Container(
              width: 4,
              height: 18,
              decoration: BoxDecoration(
                color: gold,
                borderRadius: BorderRadius.circular(10),
              ),
            ),
            const SizedBox(width: 9),
            const Text(
              'Sistem Informasi • UNIPDU',
              style: TextStyle(
                color: burgundy,
                fontSize: 15,
                fontWeight: FontWeight.w600,
              ),
            ),
          ],
        ),

        const SizedBox(height: 18),

        Text(
          'Mahasiswa Sistem Informasi yang memiliki '
          'ketertarikan pada pengembangan aplikasi, '
          'desain antarmuka, dan teknologi digital. '
          'Senang mempelajari hal baru dan mengembangkan '
          'kemampuan melalui berbagai proyek.',
          style: TextStyle(
            color: Colors.grey.shade700,
            height: 1.7,
            fontSize: 14,
          ),
        ),
      ],
    );
  }

  // =========================================================
  // CONTACT
  // Row digunakan untuk menyusun tiga kontak horizontal.
  // =========================================================
  Widget _buildContactSection() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        const Text(
          'CONTACT',
          style: TextStyle(
            color: gold,
            fontSize: 11,
            fontWeight: FontWeight.w800,
            letterSpacing: 2,
          ),
        ),

        const SizedBox(height: 15),

        Row(
          children: [
            Expanded(
              child: _buildContactItem(
                icon: Icons.email_outlined,
                label: 'Email',
                value: 'yazkaa@email.com',
              ),
            ),

            const SizedBox(width: 12),

            Expanded(
              child: _buildContactItem(
                icon: Icons.phone_outlined,
                label: 'Phone',
                value: '+62 8xx xxxx xxxx',
              ),
            ),

            const SizedBox(width: 12),

            Expanded(
              child: _buildContactItem(
                icon: Icons.code,
                label: 'GitHub',
                value: 'github.com/yazkaa',
              ),
            ),
          ],
        ),
      ],
    );
  }

  Widget _buildContactItem({
    required IconData icon,
    required String label,
    required String value,
  }) {
    return Container(
      padding: const EdgeInsets.all(14),
      decoration: BoxDecoration(
        color: const Color(0xFFFAF8F7),
        borderRadius: BorderRadius.circular(16),
        border: Border.all(
          color: const Color(0xFFEDE6E3),
        ),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Container(
            padding: const EdgeInsets.all(8),
            decoration: BoxDecoration(
              color: burgundy.withOpacity(0.08),
              borderRadius: BorderRadius.circular(10),
            ),
            child: Icon(
              icon,
              color: burgundy,
              size: 19,
            ),
          ),

          const SizedBox(height: 10),

          Text(
            label,
            style: TextStyle(
              color: Colors.grey.shade500,
              fontSize: 10,
              fontWeight: FontWeight.w600,
            ),
          ),

          const SizedBox(height: 3),

          Text(
            value,
            overflow: TextOverflow.ellipsis,
            style: const TextStyle(
              color: darkBurgundy,
              fontSize: 11,
              fontWeight: FontWeight.w700,
            ),
          ),
        ],
      ),
    );
  }

  // =========================================================
  // SKILLS
  // Wrap digunakan agar Chip otomatis pindah baris.
  // =========================================================
  Widget _buildSkillsSection() {
    const skills = [
      'Flutter',
      'Dart',
      'UI Design',
      'Microsoft Word',
      'Excel',
      'Videografi',
    ];

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        const Text(
          'SKILLS & INTERESTS',
          style: TextStyle(
            color: gold,
            fontSize: 11,
            fontWeight: FontWeight.w800,
            letterSpacing: 2,
          ),
        ),

        const SizedBox(height: 14),

        Wrap(
          spacing: 9,
          runSpacing: 9,
          children: skills.map(
            (skill) {
              return Chip(
                label: Text(skill),
                backgroundColor: Colors.white,
                side: const BorderSide(
                  color: Color(0xFFE5D9D5),
                ),
                labelStyle: const TextStyle(
                  color: darkBurgundy,
                  fontSize: 12,
                  fontWeight: FontWeight.w600,
                ),
                padding: const EdgeInsets.symmetric(
                  horizontal: 8,
                  vertical: 4,
                ),
                shape: RoundedRectangleBorder(
                  borderRadius: BorderRadius.circular(20),
                ),
              );
            },
          ).toList(),
        ),
      ],
    );
  }
}